# --- Required in production ---
# PostgreSQL connection string (Neon / Supabase / any Postgres). Leave empty locally to use the built-in PGlite database in ./.data
DATABASE_URL=
# Long random string used to sign login sessions (e.g. `openssl rand -base64 32`)
AUTH_SECRET=
# Committee registration code: only people who know it can create an account
SIGNUP_CODE=

# --- Optional: AI (organizing minutes + extracting tasks) ---
# Without it the app works fully, but minutes are organized and tasks added manually.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
